# LN COS — Variables d'environnement
# Copier vers .env.local et remplir les valeurs.

# ─── Supabase (auth admin + données) ─────────────────────────────────────────
# Dashboard : https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optionnel — mutations serveur admin (bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe (paiements) ──────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

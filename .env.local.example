# LN COS — Variables d'environnement
# Copier vers .env.local et remplir les valeurs.

# ─── Site (canonical, sitemap, OG, emails) ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.lncos.fr

# ─── Supabase (auth admin + données) ─────────────────────────────────────────
# Dashboard : https://supabase.com/dashboard/project/svxgeoklhylqivszedel/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Obligatoire en production — création commandes Stripe (/api/stripe/complete, webhook)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe (paiements) ──────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# https://dashboard.stripe.com/webhooks → endpoint https://www.lncos.fr/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Resend (emails commande + expédition) ───────────────────────────────────
# https://resend.com/api-keys — domaine lncos.fr vérifié requis en prod
RESEND_API_KEY=re_...
RESEND_FROM=LN COS <commandes@lncos.fr>

# ─── Comptes de test (E2E / QA) ──────────────────────────────────────────────
# Mot de passe commun : LncosTest2026!
# Admin  → test-admin@lncos.fr  (is_admin=true,  /login)
# Client → test-client@lncos.fr (is_admin=false, /profile)

# ─── Web Push admin (notifications commandes sur mobile) ─────────────────────
# Générer : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
